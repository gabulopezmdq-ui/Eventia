## 4. Servicio — `features/programas/programas.service.ts`

Agregar después de la sección `// Staff`:

```typescript
// ── Retiros QR ───────────────────────────────────────────────────

export const validarQR = async (payload: ValidarQRPayload): Promise<ValidarQRResponse> => {
    const res = await fetch(`${API_URL}/retiros/validar-qr`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
    });
    if (!res.ok) throw new Error('Error al validar el QR');
    return res.json();
};

export const registrarRetiro = async (payload: RegistrarRetiroPayload): Promise<RegistrarRetiroResponse> => {
    const res = await fetch(`${API_URL}/retiros/registrar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
    });
    if (!res.ok) throw new Error('Error al registrar el retiro');
    return res.json();
};

export const getRetirosDia = async (idEvento: number, fecha: string): Promise<RetirosDiaResponse> => {
    const res = await fetch(`${API_URL}/${idEvento}/retiros/dia?fecha=${fecha}`);
    if (!res.ok) throw new Error('Error al obtener los retiros del día');
    return res.json();
};
```

> [!NOTE]
> `validarQR` y `registrarRetiro` apuntan a `/api/programas/retiros/...` (sin `idEvento` en la ruta)
> porque el backend los diseñó sin el param de evento (el token ya identifica el contexto).
> `getRetirosDia` sí lleva `idEvento` como path param.

---

## 5. API Proxies Next.js

### 5.1 `GET /api/programas/[idEvento]/retiros/dia/route.ts`

Patrón idéntico a `cocina/dia/route.ts`. Reenvía `?fecha=YYYY-MM-DD` al backend.

```typescript
import { cookies } from 'next/headers';
import { NextRequest, NextResponse } from 'next/server';

const API_URL = process.env.NEXT_PUBLIC_API_URL;

export async function GET(
    request: NextRequest,
    { params }: { params: Promise<{ idEvento: string }> }
) {
    try {
        const { idEvento } = await params;
        const cookieStore = await cookies();
        const token = cookieStore.get('access_token')?.value;
        if (!token) return NextResponse.json({ message: 'No autorizado' }, { status: 401 });

        const { searchParams } = new URL(request.url);
        const url = new URL(`${API_URL}/programas/${idEvento}/retiros/dia`);
        searchParams.forEach((value, key) => url.searchParams.append(key, value));

        const res = await fetch(url.toString(), {
            method: 'GET',
            headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
            cache: 'no-store',
        });
        const text = await res.text();
        return new NextResponse(text, { status: res.status, headers: { 'Content-Type': 'application/json' } });
    } catch (error) {
        console.error('ERROR API ROUTE RETIROS DIA:', error);
        return NextResponse.json({ message: 'Error interno del proxy' }, { status: 500 });
    }
}
```

### 5.2 `POST /api/programas/[idEvento]/retiros/validar-qr/route.ts`

> [!NOTE]
> Aunque el backend no usa `idEvento` en esta ruta, el proxy vive dentro del segmento `[idEvento]`
> para mantener consistencia y permitir que el servicio simplemente invoque `/api/programas/${idEvento}/retiros/validar-qr`.
> El proxy reenvía el body tal cual al backend sin `idEvento`.

```typescript
import { cookies } from 'next/headers';
import { NextRequest, NextResponse } from 'next/server';

const API_URL = process.env.NEXT_PUBLIC_API_URL;

export async function POST(
    request: NextRequest,
    { params }: { params: Promise<{ idEvento: string }> }
) {
    try {
        await params; // necesario por Next.js pero no se usa
        const cookieStore = await cookies();
        const token = cookieStore.get('access_token')?.value;
        if (!token) return NextResponse.json({ message: 'No autorizado' }, { status: 401 });

        const body = await request.json();
        const res = await fetch(`${API_URL}/programas/retiros/validar-qr`, {
            method: 'POST',
            headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
        });
        const text = await res.text();
        return new NextResponse(text, { status: res.status, headers: { 'Content-Type': 'application/json' } });
    } catch (error) {
        console.error('ERROR API ROUTE VALIDAR QR:', error);
        return NextResponse.json({ message: 'Error interno del proxy' }, { status: 500 });
    }
}
```

### 5.3 `POST /api/programas/[idEvento]/retiros/registrar/route.ts`

Mismo patrón que `validar-qr`. Reenvía body completo.

```typescript
import { cookies } from 'next/headers';
import { NextRequest, NextResponse } from 'next/server';

const API_URL = process.env.NEXT_PUBLIC_API_URL;

export async function POST(
    request: NextRequest,
    { params }: { params: Promise<{ idEvento: string }> }
) {
    try {
        await params;
        const cookieStore = await cookies();
        const token = cookieStore.get('access_token')?.value;
        if (!token) return NextResponse.json({ message: 'No autorizado' }, { status: 401 });

        const body = await request.json();
        const res = await fetch(`${API_URL}/programas/retiros/registrar`, {
            method: 'POST',
            headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
        });
        const text = await res.text();
        return new NextResponse(text, { status: res.status, headers: { 'Content-Type': 'application/json' } });
    } catch (error) {
        console.error('ERROR API ROUTE REGISTRAR RETIRO:', error);
        return NextResponse.json({ message: 'Error interno del proxy' }, { status: 500 });
    }
}
```

