## Fase 1 – Tipos TypeScript

**Archivo:** `src/features/staff/types.ts`

```ts
// ── Roles disponibles ──────────────────────────────────────────────
export type StaffRol =
  | 'STAFF_DJ'
  | 'STAFF_MESERO'
  | 'STAFF_COCINA'
  | 'STAFF_SEGURIDAD'
  | 'STAFF_PROPIETARIO'
  | 'ACCOUNT_ADMIN';

// ── Entidad Staff ──────────────────────────────────────────────────
export interface Staff {
  id_staff: number;
  codigo: string;          // sólo disponible al crear (no persiste en UI)
  nombre: string;
  apellido: string;
  email?: string;
  telefono?: string;
  id_cuenta: number;
  rol: StaffRol;
  activo: boolean;
  fecha_expiracion?: string;
  fecha_alta?: string;
  unidades: StaffUnidad[];
}

// ── Unidad vinculada al staff ──────────────────────────────────────
export interface StaffUnidad {
  id_unidad: number;
  nombre: string;
}

// ── Payloads de API ────────────────────────────────────────────────
export interface CreateStaffInput {
  nombre: string;
  apellido: string;
  email?: string;
  telefono?: string;
  id_cuenta: number;
  rol: StaffRol;
  unidades: number[];      // array de id_unidad
}

export interface UpdateStaffInput {
  nombre?: string;
  apellido?: string;
  email?: string;
  telefono?: string;
  rol?: StaffRol;
  unidades?: number[];
}

// ── Respuesta de creación (código único) ───────────────────────────
export interface CreateStaffResponse {
  id_staff: number;
  codigo: string;
  activo: boolean;
  fecha_expiracion: string;
}

// ── Login / JWT claims ─────────────────────────────────────────────
export interface StaffLoginResponse {
  token: string;
}

export interface StaffJwtClaims {
  sub: string;
  id_staff: number;
  id_cuenta: number;
  role: StaffRol;
  is_staff: boolean;
  exp: number;
}

// ── Estado del usuario en la app staff ────────────────────────────
export interface StaffAuthUser {
  idStaff: number;
  idCuenta: number;
  role: StaffRol;
  unidades: StaffUnidad[];
}

// ── Evento accesible por el staff ─────────────────────────────────
export interface StaffEvento {
  id_evento: number;
  nombre: string;
  fecha_inicio: string;
  unidad: string;
  estado?: string;
}
```

