## Fase 2 – Servicio Frontend

**Archivo:** `src/features/staff/staff.service.ts`

Expone funciones que llaman a los proxies Next.js (`/api/staff/*`).

```ts
import type {
  Staff, CreateStaffInput, UpdateStaffInput,
  CreateStaffResponse, StaffEvento
} from './types';

const BASE = '/api/staff';

// ── Admin: CRUD ────────────────────────────────────────────────────

export async function getStaffUnidades(idCuenta: number): Promise<Staff[]> {
  const res = await fetch(`${BASE}/unidades/${idCuenta}`);
  if (!res.ok) throw new Error('Error al cargar staff');
  return res.json();
}

export async function getStaffById(id: number): Promise<Staff> {
  const res = await fetch(`${BASE}/${id}`);
  if (!res.ok) throw new Error('Error al cargar staff');
  return res.json();
}

export async function createStaff(input: CreateStaffInput): Promise<CreateStaffResponse> {
  const res = await fetch(BASE, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(input),
  });
  if (!res.ok) throw new Error('Error al crear staff');
  return res.json();
}

export async function updateStaff(id: number, input: UpdateStaffInput): Promise<{ ok: boolean }> {
  const res = await fetch(`${BASE}/${id}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(input),
  });
  if (!res.ok) throw new Error('Error al actualizar staff');
  return res.json();
}

export async function deleteStaff(id: number): Promise<{ ok: boolean }> {
  const res = await fetch(`${BASE}/${id}`, { method: 'DELETE' });
  if (!res.ok) throw new Error('Error al desactivar staff');
  return res.json();
}

export async function patchStaffActivo(id: number, activo: boolean): Promise<{ ok: boolean }> {
  const res = await fetch(`${BASE}/${id}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ activo }),
  });
  if (!res.ok) throw new Error('Error al cambiar disponibilidad');
  return res.json();
}

// ── Portal Staff: autenticación y eventos ─────────────────────────

export async function loginStaff(codigo: string): Promise<string> {
  const res = await fetch(`${BASE}/login`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ codigo }),
  });
  if (!res.ok) throw new Error('Código inválido o expirado');
  const data = await res.json();
  return data.token as string;
}

export async function getEventosStaff(
  tipo: 'personal' | 'cuenta',
  params: { staffId?: number; cuentaId?: number; unidades?: number[] }
): Promise<StaffEvento[]> {
  const qs = new URLSearchParams();
  if (tipo === 'personal' && params.staffId) qs.set('staffId', String(params.staffId));
  if (tipo === 'cuenta' && params.cuentaId) {
    qs.set('cuentaId', String(params.cuentaId));
    if (params.unidades?.length) qs.set('unidades', params.unidades.join(','));
  }
  const res = await fetch(`/api/eventos?${qs.toString()}`);
  if (!res.ok) throw new Error('Error al cargar eventos');
  return res.json();
}

export async function checkinEvento(idEvento: number): Promise<{ ok: boolean; hora: string }> {
  const res = await fetch(`/api/eventos/${idEvento}/checkin`, { method: 'POST' });
  if (!res.ok) throw new Error('Error en check-in');
  return res.json();
}
```

